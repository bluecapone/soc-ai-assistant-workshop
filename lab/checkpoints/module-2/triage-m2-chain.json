      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1500,
        520
      ],
      "credentials": {
        "openAiApi": {
          "id": "credModelGatewy1",
          "name": "Model gateway"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"suggested_close_state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"true positive\",\n        \"false positive\",\n        \"true positive not malicious\",\n        \"other\"\n      ]\n    },\n    \"recommended_actions\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"suggested_close_state\",\n    \"recommended_actions\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "c0000009-0000-4000-8000-000000000009",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1700,
        520
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "caseId",
              "type": "string",
              "value": "={{ $('Assemble context').first().json.caseId }}"
            },
            {
              "id": "a2",
              "name": "verdict",
              "type": "string",
              "value": "=### Summary\n{{ $json.output.summary }}\n\n### Suggested close state\n{{ $json.output.suggested_close_state }}\n\n### Recommended actions\n{{ $json.output.recommended_actions }}\n\nWritten by the Module 2 workflow (Basic LLM Chain, model {{ $env.MODEL_WEAK }})."
            }
          ]
        },
        "options": {}
      },
      "id": "c0000010-0000-4000-8000-000000000010",
      "name": "Render verdict",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
