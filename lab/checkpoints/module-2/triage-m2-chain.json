        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.verdict }) }}",
        "options": {}
      },
      "id": "c0000011-0000-4000-8000-000000000011",
      "name": "Write verdict to TheHive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "credTheHiveN8n01",
          "name": "TheHive n8n"
        }
      }
    }
