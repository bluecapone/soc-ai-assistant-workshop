    {
      "parameters": {
        "toolDescription": "Return the 20 most recent Wazuh alerts whose source IP equals the given ip. Use it to see what else this address did before and after the event.",
        "method": "POST",
        "url": "https://wazuh.indexer:9200/wazuh-alerts-*/_search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"size\": 20, \"_source\": [\"timestamp\",\"rule.id\",\"rule.level\",\"rule.description\",\"data.srcip\",\"data.url\",\"data.dstuser\",\"agent.name\"], \"query\": { \"match\": { \"data.srcip\": \"{{ $fromAI('ip', 'IPv4 address of the source to look up', 'string') }}\" } }, \"sort\": [ { \"timestamp\": \"desc\" } ] }",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "c0000032-0000-4000-8000-000000000032",
      "name": "wazuh_events_for_ip",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1960,
        640
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "credWazuhIndex01",
          "name": "Wazuh indexer"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Return the 20 most recent Wazuh alerts on the given host (the Wazuh agent name).",
        "method": "POST",
        "url": "https://wazuh.indexer:9200/wazuh-alerts-*/_search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"size\": 20, \"_source\": [\"timestamp\",\"rule.id\",\"rule.level\",\"rule.description\",\"data.srcip\",\"data.url\",\"data.dstuser\",\"agent.name\"], \"query\": { \"match\": { \"agent.name\": \"{{ $fromAI('host', 'Wazuh agent name of the host', 'string') }}\" } }, \"sort\": [ { \"timestamp\": \"desc\" } ] }",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "c0000033-0000-4000-8000-000000000033",
      "name": "wazuh_events_for_host",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        2120,
