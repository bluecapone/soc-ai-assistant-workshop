# Secrets: the real per-attendee gateway key and TheHive API keys live here.
.env

# Python cruft from local testing.
__pycache__/
*.pyc

# Generated Wazuh certs (demo, regenerated by the certs-generator).
platform/wazuh/certs/generated/

# Runtime ossec.conf with the substituted integrator key (generated by start.sh).
platform/wazuh/ossec.runtime.conf

# Range action audit log (written by range-control at runtime).
logs/
