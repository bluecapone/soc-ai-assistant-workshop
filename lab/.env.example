# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Model gateway (ADR-0002) ---------------------------------------------
# Workshop gateway (LiteLLM, ADR-0009). start.sh forces GATEWAY_BASE_URL to the fixed
# workshop host on every run; only GATEWAY_API_KEY needs a real per-attendee value.
GATEWAY_BASE_URL=https://workshop-ai.bluecap.one/v1
GATEWAY_API_KEY=replace-with-per-attendee-key
MODEL_WEAK=gemini-3.5-flash-lite
MODEL_FRONTIER=claude-sonnet-5

# --- Reputation lookups ---------------------------------------------------
# Optional. AbuseIPDB key for the reputation lookups (free tier, 1000 checks/day,
# https://www.abuseipdb.com/account/api). Empty = the lookup node reports "unavailable".
OSINT_API_KEY=

# --- TheHive --------------------------------------------------------------
# Secret used to bootstrap the instance; the integrator and n8n authenticate
# with API keys minted after first boot (see wazuh/README and n8n/README).
THEHIVE_SECRET=change-me-to-a-long-random-string
THEHIVE_ORG=soclab
# API key n8n and the Module 1 skill use to write verdicts back. start.sh mints it and fills this in.
THEHIVE_N8N_APIKEY=replace-after-first-boot

# --- Wazuh ----------------------------------------------------------------
# The Wazuh services use credentials baked into docker-compose.yml and
# wazuh/config/wazuh_indexer/internal_users.yml: admin / brucon2026 (indexer),
# wazuh-wui / MyS3cr37P450r.*- (API), kibanaserver / kibanaserver (dashboard).
# To change credentials, regenerate the bcrypt hashes in internal_users.yml and
# update docker-compose.yml to match.

# --- Threat intel (abuse.ch) ----------------------------------------------
# One Auth-Key from https://auth.abuse.ch, works across ThreatFox,
# MalwareBazaar, and URLhaus. Used only by scripts/fetch_threat_intel.py to
# refresh threat-intel/iocs.csv before the event. Never committed.
ABUSECH_AUTH_KEY=replace-with-your-abusech-key

# --- OSINT reputation keys ------------------------------------------------
# OSINT reputation keys the reference workflow and checkpoints use (attendees use
# their own in their own n8n during the workshop). VirusTotal covers hashes and
# domains; AbuseIPDB covers IPs.
VT_API_KEY=replace-with-your-virustotal-key
ABUSEIPDB_API_KEY=replace-with-your-abuseipdb-key

# --- n8n AI assistant sandbox ---------------------------------------------
# The in-editor assistant runs in the sandbox-* services. start.sh generates
# these secrets on first run and writes them here; leave them blank and let it.
# The assistant's model calls reuse GATEWAY_BASE_URL / GATEWAY_API_KEY above.
N8N_SANDBOX_VERSION=latest
SANDBOX_API_KEYS=
N8N_SANDBOX_SERVICE_API_KEY=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SANDBOX_RUNNER_API_KEYS=
SEARXNG_SECRET=

# --- Console source IPs ---------------------------------------------------
# The single attacker IP shown on the console and used for ALL malicious attacks.
# Must be an IP AbuseIPDB flags (one of threat-intel/malicious-ips.txt).
ATTACKER_IP=223.159.80.211
# The single benign source IP shown on the console and used for ALL benign actions.
# A clean address from the benign range (35.235.240.0/24). The SIEM noise never uses it.
BENIGN_IP=35.235.240.10
